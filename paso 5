class reserva:
#aca se crea el constructor ya que para hacer una reserva se necesita saber quien fue y que servicio esta reservando y cuando.
 def init (self,cliente,servicio,fecha_reserva):
 
#aca se verifica que real mente si sea un cliente o sino el sistema lanza un error
  if not isinstance(cliente, cliente):
   raise datoinvalidoerror("El cliente no es valido")
#aca se verifica que real mente si es un servicio o sino el sistema lanza un error  
  if not isinstance(servicio, servicio):
